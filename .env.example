# Environment (development, production, test)
ENV=development

# === Database Configuration ===
# 
# Choose the appropriate URLs based on your setup:
#
# 1. Using Docker Compose (recommended):
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres_main:5432/fastapi_pillar
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres_test:5432/fastapi_pillar_test
#
# 2. Local PostgreSQL (without Docker):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5488/fastapi_pillar
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5489/fastapi_pillar_test
#
# 3. Remote/Production:
# DATABASE_URL=postgresql+psycopg://user:password@your-db-host:5432/fastapi_pillar